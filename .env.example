# Comma-separated ip:port:certhash entries. Demo gateway; replace for deployment.
VITE_ANON_GATEWAYS=152.236.3.22:12298:uEiCH0VdbhryzJcMtCfB0vLA4sOvHdQ4hq5w7CopcwU59bQ
# Prefer distinct operators. Wallets retain their assigned endpoint during retries.
VITE_RPC_URLS=https://ethereum-rpc.publicnode.com,https://eth.drpc.org,https://rpc.ankr.com/eth
