{
  "name": "anonfolio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc --noEmit && vite build",
    "test": "bun test ./tests",
    "serve": "bun scripts/serve.ts",
    "test:browser": "playwright test",
    "test:live": "LIVE_RPC=1 playwright test --grep \"live mainnet\"",
    "test:static": "BASE_URL=http://127.0.0.1:4173 playwright test --grep \"static build\"",
    "test:all": "bun run test && bun run build && bun run test:browser && bun run test:static"
  },
  "dependencies": {
    "@anon-rpc/browser-harness": "0.4.0",
    "viem": "2.38.0"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/bun": "latest",
    "typescript": "5.9.3",
    "vite": "7.2.0"
  }
}
