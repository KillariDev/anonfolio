{
  "name": "anonfolio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "bun --bun tsc --noEmit && bun --bun vite build",
    "test": "bun test ./tests",
    "serve": "bun scripts/serve.ts",
    "test:browser": "playwright test",
    "test:live": "LIVE_RPC=1 playwright test --grep \"live mainnet\"",
    "test:static": "BASE_URL=http://127.0.0.1:4173 playwright test --grep \"static build\"",
    "test:all": "bun run test && bun run build && bun run test:browser && bun run test:static",
    "typecheck": "bun --bun tsc --noEmit --project tsconfig.json",
    "check": "bun run test && bun run typecheck && bun run build",
    "ui:docker": "bun ./scripts/build-docker.mts anonfolio-ui && docker run --rm --add-host=host.docker.internal:host-gateway --env IPFS_API_MULTIADDR anonfolio-ui",
    "test:ipfs": "bun scripts/test-ipfs.mts",
    "bootstrap:update": "bun scripts/update-tor-bootstrap.ts",
    "test:live:https": "LIVE_HTTPS=1 playwright test --grep \"live mainnet verified ETH and WETH through explicitly selected HTTPS\""
  },
  "dependencies": {
    "@anon-rpc/browser-harness": "0.4.0",
    "@ethereumjs/trie": "6.2.1",
    "buffer": "6.0.3",
    "events": "3.3.0",
    "viem": "2.38.0"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/bun": "latest",
    "typescript": "5.9.3",
    "vite": "7.3.7"
  },
  "packageManager": "bun@1.3.14",
  "engines": {
    "bun": ">=1.3.14"
  },
  "overrides": {
    "ws": "8.22.1"
  }
}
